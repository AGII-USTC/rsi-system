[Unit]
Description=Embodied RSI bounded experiment worker

[Service]
Type=oneshot
WorkingDirectory=%h/rsi_system
ExecStart=%h/rsi_system/.venv/bin/python -m rsi_system.core work-once --quiet-empty
Environment=PYTHONUNBUFFERED=1
Environment=CUDA_VISIBLE_DEVICES=
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=MUJOCO_GL=egl
Nice=10
CPUQuota=100%
MemoryMax=2G
TasksMax=64
TimeoutStartSec=32min
TimeoutStopSec=10s
KillMode=control-group
NoNewPrivileges=true
UMask=0077
